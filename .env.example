# ─── Google / Vertex AI ───────────────────────────────────────────────────────
# Vertex AI Express API key — used by Gemini LLM (analyzer, voice chat, livekit agent)
VERTEX_AI_API_KEY=

# Gemini model to use (optional, defaults to gemini-2.5-flash-lite)
VERTEX_MODEL=gemini-2.5-flash-lite

# Path to Google Cloud service account JSON — used by Cloud Vision (OCR) and LiveKit STT/TTS
# Defaults to ./vertex_key.json if the file is present; set this only if using a different path
GOOGLE_APPLICATION_CREDENTIALS=./vertex_key.json

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cloudinary (optional — image/file storage) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── LiveKit (voice agent) ────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Server ───────────────────────────────────────────────────────────────────
# Port for the Flask backend (optional, defaults to 5001)
PORT=5001

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Backend API base URL
VITE_BACKEND_URL=http://localhost:5001

# LiveKit — same values as above, exposed to the frontend
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_LIVEKIT_API_KEY=
VITE_LIVEKIT_API_SECRET=

# Supabase public URL (same as SUPABASE_URL)
VITE_SUPABASE_URL=

# Cartesia API key — only needed if you use Cartesia STT/TTS in the frontend
VITE_CARTESIA_API_KEY=
